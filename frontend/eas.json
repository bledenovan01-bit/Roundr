{
  "cli": {
    "version": "25.2.0",
    "requireCommit": true,
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "autoIncrement": false,
      "android": {
        "buildType": "apk",
        "image": "sdk-58",
        "resourceClass": "medium"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "image": "sdk-58",
        "resourceClass": "medium"
      },
      "env": {
        "ROUNDR_SPOTIFY_EXPERIMENT": "0"
      }
    },
    "testflight-spotify": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "ROUNDR_SPOTIFY_EXPERIMENT": "1"
      },
      "ios": {
        "image": "sdk-58",
        "resourceClass": "medium"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "ROUNDR_SPOTIFY_EXPERIMENT": "0"
      },
      "ios": {
        "image": "sdk-58",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "testflight-spotify": {
      "ios": {}
    },
    "production": {
      "ios": {}
    }
  }
}
