{
  "expo": {
"owner": "denoevans",
"name": "Roundr",
"slug": "roundr",
"version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "roundr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bledenovan.roundr",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Roundr utilise l’accès à Musique pour afficher et commander le morceau en cours pendant vos matchs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#020909"
      },
      "package": "com.bledenovan.roundr.recette"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router", {"asyncRoutes": {"web": false}}],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#020909"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
  "expo-audio",
  {
    "recordAudioAndroid": false,
    "microphonePermission": false,
    "enableBackgroundRecording": false,
    "enableBackgroundPlayback": false
  }
],
      "expo-asset",
      "./modules/roundr-spotify-remote/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb2a6c2e-7e12-41ef-bdb6-9c3ebca1a23a"
      }
    }
  }
}
